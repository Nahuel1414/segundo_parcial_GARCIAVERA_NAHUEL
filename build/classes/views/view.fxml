      <ListView fx:id="listCarrito" layoutX="465.0" layoutY="84.0" prefHeight="200.0" prefWidth="288.0" />
      <Label fx:id="lblMensaje" layoutX="287.0" layoutY="26.0">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
   </children>
</AnchorPane>

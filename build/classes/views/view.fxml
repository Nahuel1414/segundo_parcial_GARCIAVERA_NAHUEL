      <TableView fx:id="tabla" layoutX="14.0" layoutY="84.0" prefHeight="316.0" prefWidth="288.0">
        <columns>
          <TableColumn fx:id="cNombre" prefWidth="101.0" text="Nombre" />
          <TableColumn fx:id="cPrecio" prefWidth="88.0" text="Precio" />
          <TableColumn fx:id="cStock" prefWidth="98.0" text="Stock" />
        </columns>
      </TableView>
      <TextField fx:id="txtCant" layoutX="354.0" layoutY="150.0" prefHeight="25.0" prefWidth="65.0" />
      <Label fx:id="lblCant" layoutX="309.0" layoutY="153.0" text="Cant:">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Button fx:id="btnAgregar" layoutX="354.0" layoutY="184.0" mnemonicParsing="false" onAction="#agregar" prefHeight="25.0" prefWidth="65.0" text="Agregar" />
      <Label fx:id="lblCarrito" layoutX="465.0" layoutY="53.0" text="Carrito">
         <font>
            <Font size="14.0" />
